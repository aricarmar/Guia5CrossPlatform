
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#101322"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guia5CrossPlatform"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#C6A5FF"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MENÚ PRINCIPAL"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona una opción para continuar"
            android:textSize="16sp"
            android:textColor="#DDD6FE"
            android:gravity="center"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="35dp" />

        <Button
            android:id="@+id/btnClicks"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="CONTADOR DE CLICS"
            android:textColor="#FFFFFF"
            android:backgroundTint="#673AB7" />

        <Button
            android:id="@+id/btnClima"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="REGISTRO AMBIENTAL"
            android:textColor="#FFFFFF"
            android:backgroundTint="#673AB7"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnHistorial"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:text="VER HISTORIAL"
            android:textColor="#FFFFFF"
            android:backgroundTint="#45227D"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>
